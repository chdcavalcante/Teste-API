	},
	"item": [
		{
			"name": "Consulta do repositório após exclusão",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pré-requisito robusto para fluxo completo de manipulação de repositório no GitHub",
							"// Etapas: deletar repositório (se existir), buscar usuário autenticado, criar repositório, consultar repositório, criar issue, consultar issue, excluir repositório, consultar após exclusão",
							"// Cada etapa possui validações claras de status code e propriedades relevantes, sem interromper o fluxo em caso de falha",
							"",
							"// Funções utilitárias",
							"function setVar(k, v) { pm.environment.set(k, v); }",
							"function getVar(k) { return pm.environment.get(k); }",
							"function validarVariavel(nome, valor) {",
							"    pm.test(`[Pré-req] Variável obrigatória '${nome}' está definida`, function () {",
							"        pm.expect(valor, `Variável '${nome}' não está definida ou está vazia`).to.not.be.oneOf([undefined, null, '']);",
							"    });",
							"}",
							"function registrarErro(nome, erro) {",
							"    pm.test(nome + ' [ERRO]', function () {",
							"        pm.expect.fail(erro);",
							"    });",
							"}",
							"",
							"// 1. Validar variáveis obrigatórias",
							"const baseUrl = getVar('baseUrl');",
							"const token = getVar('token_github');",
							"const nomeRepositorio = getVar('nome_repositorio') || 'repotesteconsulta';",
							"validarVariavel('baseUrl', baseUrl);",
							"validarVariavel('token_github', token);",
							"validarVariavel('nome_repositorio', nomeRepositorio);",
							"",
							"// 2. Tentar deletar repositório antes de criar",
							"(function() {",
							"    const usuarioGithub = getVar('usuario_github') || 'usuario_invalido';",
							"    const repoDeleteUrl = `${baseUrl}/repos/${usuarioGithub}/${nomeRepositorio}`;",
							"    pm.sendRequest({",
							"        url: repoDeleteUrl,",
							"        method: 'DELETE',",
							"        header: {",
							"            'Authorization': 'Bearer ' + token,",
							"            'Accept': 'application/vnd.github+json'",
							"        }",
							"    }, function (err, res) {",
							"        // Validação da tentativa de exclusão",
							"        pm.test('[Pré-req] Tentativa de exclusão prévia do repositório', function () {",
							"            pm.expect([204, 404]).to.include(res.code);",
							"        });",
							"        if (err) registrarErro('[Pré-req] Tentativa de exclusão prévia do repositório', err.message);",
							"    });",
							"})();",
							"",
							"// 3. Buscar usuário autenticado",
							"(function() {",
							"    pm.sendRequest({",
							"        url: `${baseUrl}/user`,",
							"        method: 'GET',",
							"        header: {",
							"            'Authorization': 'Bearer ' + token,",
							"            'Accept': 'application/vnd.github+json'",
							"        }",
							"    }, function (err, res) {",
							"        pm.test('[Pré-req] Buscar usuário autenticado - status 200', function () {",
							"            pm.expect(res.code).to.eql(200);",
							"        });",
							"        if (res.code === 200) {",
							"            setVar('usuario_github', res.json().login);",
							"        }",
							"        if (err) registrarErro('[Pré-req] Buscar usuário autenticado', err.message);",
							"    });",
							"})();",
							"",
							"// 4. Criar repositório",
							"(function() {",
							"    pm.sendRequest({",
							"        url: `${baseUrl}/user/repos`,",
							"        method: 'POST',",
							"        header: {",
							"            'Authorization': 'Bearer ' + token,",
							"            'Accept': 'application/vnd.github+json',",
							"            'Content-Type': 'application/json'",
							"        },",
							"        body: {",
							"            mode: 'raw',",
							"            raw: JSON.stringify({ name: nomeRepositorio, auto_init: true })",
							"        }",
							"    }, function (err, res) {",
							"        pm.test('[Pré-req] Criar repositório - status 201', function () {",
							"            pm.expect(res.code).to.eql(201);",
							"        });",
							"        pm.test('[Pré-req] Criar repositório - body contém id', function () {",
							"            pm.expect(res.json().id).to.be.a('number');",
							"        });",
							"        if (res.code === 201) {",
							"            setVar('id_repositorio', res.json().id);",
							"        }",
							"        if (err) registrarErro('[Pré-req] Criar repositório', err.message);",
							"    });",
							"})();",
							"",
							"// 5. Criar issue",
							"(function() {",
							"    const usuarioGithub = getVar('usuario_github');",
							"    pm.sendRequest({",
							"        url: `${baseUrl}/repos/${usuarioGithub}/${nomeRepositorio}/issues`,",
							"        method: 'POST',",
							"        header: {",
							"            'Authorization': 'Bearer ' + token,",
							"            'Accept': 'application/vnd.github+json',",
							"            'Content-Type': 'application/json'",
							"        },",
							"        body: {",
							"            mode: 'raw',",
							"            raw: JSON.stringify({ title: 'Issue de teste', body: 'Criada via script.' })",
							"        }",
							"    }, function (err, res) {",
							"        pm.test('[Pré-req] Criar issue - status 201', function () {",
							"            pm.expect(res.code).to.eql(201);",
							"        });",
							"        pm.test('[Pré-req] Criar issue - body contém number', function () {",
							"            pm.expect(res.json().number).to.be.a('number');",
							"        });",
							"        if (res.code === 201) {",
							"            setVar('numero_issue', res.json().number);",
							"        }",
							"        if (err) registrarErro('[Pré-req] Criar issue', err.message);",
							"    });",
							"})();",
							"",
							"// 6. Excluir repositório",
							"(function() {",
							"    const usuarioGithub = getVar('usuario_github');",
							"    pm.sendRequest({",
							"        url: `${baseUrl}/repos/${usuarioGithub}/${nomeRepositorio}`,",
							"        method: 'DELETE',",
							"        header: {",
							"            'Authorization': 'Bearer ' + token,",
							"            'Accept': 'application/vnd.github+json'",
							"        }",
							"    }, function (err, res) {",
							"        pm.test('[Pré-req] Excluir repositório - status 204', function () {",
							"            pm.expect(res.code).to.eql(204);",
							"        });",
							"        if (err) registrarErro('[Pré-req] Excluir repositório', err.message);",
							"    });",
							"})();",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code é 404 após exclusão', function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token_github}}"
					},
					{
						"key": "Accept",
						"value": "application/vnd.github+json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/repos/{{usuario_github}}/{{nome_repositorio}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"repos",
						"{{usuario_github}}",
						"{{nome_repositorio}}"
					]
				}
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Pré-requisito reforçado: garantir existência do repositório e nome válido",
					"",
					"// 1. Verifica se a variável nome_repositorio está definida e não vazia",
					"var nomeRepositorio = pm.environment.get('nome_repositorio');",
					"if (!nomeRepositorio || nomeRepositorio.trim() === \"\") {",
					"    throw new Error('A variável \"nome_repositorio\" está vazia ou não definida. Defina um nome válido para o repositório.');",
					"}",
					"",
					"// 2. Busca o usuário autenticado",
					"pm.sendRequest({",
					"    url: pm.environment.get('baseUrl') + '/user',",
					"    method: 'GET',",
					"    header: {",
					"        'Authorization': 'Bearer ' + pm.environment.get('token_github'),",
					"        'Accept': 'application/vnd.github+json'",
					"    }",
					"}, function (err, res) {",
					"    if (err || res.code !== 200) {",
					"        throw new Error('Falha ao obter usuário autenticado. Verifique o token de acesso.');",
					"    }",
					"    var usuario = res.json().login;",
					"    pm.environment.set('usuario_github', usuario);",
					"    // 3. Verifica se o repositório existe",
					"    pm.sendRequest({",
					"        url: pm.environment.get('baseUrl') + '/repos/' + usuario + '/' + nomeRepositorio,",
					"        method: 'GET',",
					"        header: {",
					"            'Authorization': 'Bearer ' + pm.environment.get('token_github'),",
					"            'Accept': 'application/vnd.github+json'",
					"        }",
					"    }, function (err, res) {",
					"        if (res.code === 404) {",
					"            // Só cria o repositório se não existir",
					"            pm.sendRequest({",
					"                url: pm.environment.get('baseUrl') + '/user/repos',",
					"                method: 'POST',",
					"                header: {",
					"                    'Authorization': 'Bearer ' + pm.environment.get('token_github'),",
					"                    'Accept': 'application/vnd.github+json',",
					"                    'Content-Type': 'application/json'",
					"                },",
					"                body: {",
					"                    mode: 'raw',",
					"                    raw: JSON.stringify({",
					"                        name: nomeRepositorio,",
					"                        auto_init: true",
					"                    })",
					"                }",
					"            }, function (err, res) {",
					"                if (res.code !== 201) {",
					"                    throw new Error('Falha ao criar repositório. Detalhes: ' + res.code + ' - ' + res.text());",
					"                }",
					"            });",
					"        } else if (res.code === 200) {",
					"            // Não tenta criar se já existir",
					"            // Apenas segue normalmente",
					"        } else {",
					"            throw new Error('Erro ao consultar repositório. Código: ' + res.code + ' - ' + res.text());",
					"        }",
					"    });",
					"});"
				]
			}
		}
	]
}